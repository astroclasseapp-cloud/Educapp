{
  "name": "educapp",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.educapp.app",
    "productName": "Educapp",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Educapp-Setup.exe",
      "icon": "icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "astroclasseapp-cloud",
      "repo": "Educapp"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "26.15.3"
  }
}